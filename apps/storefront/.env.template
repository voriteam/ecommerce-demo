# Copy to .env.local. `pnpm setup` does this for you, and fills in the
# publishable key from the store it just created.

NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
