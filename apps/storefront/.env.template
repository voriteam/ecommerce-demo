# Copy to .env.local. `pnpm setup` does this for you, and fills in the
# publishable key from the store it just created.

NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_REGION=us
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Stripe publishable key, test mode. Pairs with STRIPE_API_KEY on the backend.
NEXT_PUBLIC_STRIPE_KEY=

# Datacap WebToken key for Vori Payments, from the store's Datacap merchant.
# It can only tokenize a card, never charge one, so it is safe in the browser.
# Pairs with VORI_PAYMENTS_ENABLED on the backend. Leave it empty to hide Vori
# Payments at checkout.
NEXT_PUBLIC_DATACAP_TOKEN_KEY=
# `test` tokenizes against Datacap's test environment, `live` its production
# one. Has to match VORI_PAYMENTS_MODE on the backend.
NEXT_PUBLIC_VORI_PAYMENTS_MODE=test

NODE_ENV=development
