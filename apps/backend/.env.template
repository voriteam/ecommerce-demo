# Copy to .env. `pnpm setup` does this for you.

# Matches docker-compose.yml. The non-default ports keep this out of the way of
# any Postgres or Redis you already run locally.
DATABASE_URL=postgres://medusa:medusa@localhost:5433/medusa
REDIS_URL=redis://localhost:6380

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Demo values. Replace them if this is ever exposed to anything. `pnpm setup`
# generates a random AUTH_MFA_ENCRYPTION_KEY, which has to be 32 bytes of hex.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=

# Stripe, in test mode. Without a key the payment provider is left
# unregistered, and the catalog and inventory halves of the demo still work.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Vori grocer-facing API
#
# VORI_API_KEY is read only on the backend. It never reaches the storefront
# bundle, and the client module refuses to load in a browser at all.
# ---------------------------------------------------------------------------
VORI_API_BASE_URL=https://api.vori.com
VORI_API_KEY=
VORI_STORE_ID=

# Catalog and inventory reads. Safe to leave on: they only ever GET.
VORI_SYNC_ENABLED=true
VORI_SYNC_CRON=*/2 * * * *

# Transaction writes, off by default. While this is false an order is fully
# built and stored on the order record but never sent. Turn it on only when
# pointed at a store you are certain you should be writing into.
VORI_WRITE_ENABLED=false
