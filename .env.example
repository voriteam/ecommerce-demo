# ---------------------------------------------------------------------------
# Payload / Next
# ---------------------------------------------------------------------------
PAYLOAD_SECRET=change-me-to-a-long-random-string
# libSQL/SQLite file. On Fly this points at the mounted volume (/data).
DATABASE_URI=file:./ecommerce-demo.db

COMPANY_NAME="Vori"
SITE_NAME="Vori Market"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# ---------------------------------------------------------------------------
# Stripe (test mode only — this demo never takes a real payment)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# ---------------------------------------------------------------------------
# Vori grocer-facing API
#
# VORI_API_KEY is read only on the server. It must never be given a
# NEXT_PUBLIC_ prefix and never be referenced from a client component —
# src/vori/client.ts imports 'server-only' so the bundler enforces this.
# ---------------------------------------------------------------------------
VORI_API_BASE_URL=https://api.vori.com
VORI_API_KEY=
VORI_STORE_ID=

# Catalog/inventory reads. Safe to leave on: they only ever GET.
VORI_SYNC_ENABLED=true
VORI_SYNC_CRON=*/2 * * * *

# Transaction writes. Both default to the safe setting: with WRITE_ENABLED
# false, or DRY_RUN true, orders are fully built and stored on the order
# document but never POSTed. Flip both only when pointed at a store you are
# certain you should be writing into.
VORI_WRITE_ENABLED=false
VORI_DRY_RUN=true
